# Kopiere diese Datei zu ".env.local" und trage deine eigenen Werte ein.
# ".env.local" wird NIEMALS zu GitHub hochgeladen (siehe .gitignore).

# Claude API Key von https://console.anthropic.com  (GEHEIM, nur Server)
ANTHROPIC_API_KEY=sk-ant-...

# Spotify Client ID von https://developer.spotify.com/dashboard
# Das ist KEIN Geheimnis - die Client ID ist öffentlich sichtbar und darf
# auch im Browser auftauchen. Den "Client Secret" brauchen wir NICHT,
# weil SongLingua den sichereren PKCE-Login-Flow nutzt.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=deine-spotify-client-id

# Muss EXAKT mit der Redirect URI übereinstimmen, die du im Spotify
# Dashboard unter "Redirect URIs" einträgst, inkl. https:// und ohne
# abschließenden Slash, z.B.:
# https://songlingua-thomas.vercel.app/callback
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=https://deine-app.vercel.app/callback
